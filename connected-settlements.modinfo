<?xml version="1.0" encoding="utf-8"?>
<Mod id="jc-connected-settlements" version="2"
    xmlns="ModInfo">
    <Properties>
        <Name>LOC_MOD_CS_NAME</Name>
        <Version>0.2.0</Version>
        <Description>LOC_MOD_CS_DESCRIPTION</Description>
        <Authors>josephcasey</Authors>
        <Package>Mod</Package>
        <!-- UI-only mod: does not change game rules, so it is save-safe. -->
        <AffectsSavedGames>0</AffectsSavedGames>
    </Properties>
    <Dependencies>
        <Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME" />
    </Dependencies>
    <ActionCriteria>
        <Criteria id="always">
            <AlwaysMet/>
        </Criteria>
    </ActionCriteria>
    <ActionGroups>
        <!--
            scope="game" runs inside a loaded game (where the City Details
            panel lives). LoadOrder 1000 loads after the base UI so our
            Controls.decorate() call finds the vanilla panel already defined.
        -->
        <ActionGroup id="cs-ui" scope="game" criteria="always">
            <Properties>
                <LoadOrder>1000</LoadOrder>
            </Properties>
            <Actions>
                <UIScripts>
                    <Item>ui/cs-connections-model.js</Item>
                    <Item>ui/cs-panel-production-chooser.js</Item>
                </UIScripts>
                <UpdateText>
                    <Item>text/en_us/InGameText.xml</Item>
                </UpdateText>
            </Actions>
        </ActionGroup>
    </ActionGroups>
    <LocalizedText>
        <File>text/en_us/ModInfoText.xml</File>
    </LocalizedText>
</Mod>
